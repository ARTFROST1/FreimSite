# ============================================================================
#  Environment variables — copy to .env and fill in per project.
#  Variables prefixed with PUBLIC_ are exposed to the browser (client-side).
#  Everything else is server-only (used by API routes in SSR mode).
# ============================================================================

# ── Analytics: Yandex Metrika ───────────────────────────────────────────────
# Counter ID from https://metrika.yandex.ru. Leave empty to disable tracking.
# Настройка счётчика руками (создание, цели, Вебвизор): docs/recipes/metrika-guide.md
PUBLIC_YANDEX_METRIKA_ID=

# Consent-gate Метрики (152-ФЗ): пусто/1 = tag.js грузится только после
# согласия из CookieConsent (цели копятся в очереди ym и не теряются);
# 0/false = грузить сразу — решение за заказчиком/юристом проекта.
PUBLIC_METRIKA_CONSENT_GATE=

# Верификация Яндекс.Вебмастера / Google Search Console. Коды публичны (видны
# в HTML любому), но привязаны к конкретному домену — под каждый новый проект
# выпускаются заново при подключении сайта в соответствующем кабинете. Пусто
# = мета-тег не рендерится вовсе (ничего не подтверждено).
PUBLIC_YANDEX_VERIFICATION=
PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Contact form ────────────────────────────────────────────────────────────
# ПУСТО (по умолчанию) = встроенный лид-пайплайн v2: черновик шага 1 на
# /api/lead/draft/, полная заявка на /api/lead/complete/ (hybrid-режим,
# активация роутов — src/pages/api/lead/*.ts.example и
# docs/recipes/lead-pipeline.md).
# Значение = внешний форм-бэкенд, принимающий JSON (Formspree, Getform,
# Web3Forms и т.п.): полная заявка уходит туда, черновики шага 1 ОТКЛЮЧАЮТСЯ.
PUBLIC_CONTACT_ENDPOINT=

# ── Лид-пайплайн v2 (server-only, hybrid-режим) ─────────────────────────────
# Куда писать лиды/черновики/вложения. На проде — АБСОЛЮТНЫЙ путь в каталог,
# который переживает деплой (shared-директория вне dist/).
# Пусто = ./data (локальная разработка).
LEAD_DATA_DIR=
# Приёмники ботов (fan-out), через запятую, напр.:
#   http://127.0.0.1:8091/notify,http://127.0.0.1:8092/notify
# Числа обязаны совпадать с TELEGRAM_NOTIFY_PORT / MAX_NOTIFY_PORT ниже.
LEAD_NOTIFY_URLS=
# Общий секрет сайта и ботов (X-Bot-Secret). openssl rand -hex 24
LEAD_NOTIFY_SECRET=
# Через сколько минут авто-отправлять черновик без шага 2 (дефолт 15).
LEAD_FLUSH_MINUTES=
# Через сколько дней удалять вложения лидов (PII!) из data/attachments.
# Пусто/0 (дефолт) — хранить вечно. Сами файлы к этому моменту уже доставлены
# в мессенджеры и живут в переписке; журнал leads.jsonl не трогается никогда.
LEAD_ATTACH_TTL_DAYS=

# Ловушка для ботов (honeypot): скрытое поле в формах. Заполнено — заявка НЕ
# идёт менеджерам, но и не теряется: ложится в data/quarantine/ (читает
# server/lead-flusher.mjs). Здесь — сколько дней её там держать, прежде чем
# удалить (0 — не удалять). Смысл срока: успеть заметить ложное срабатывание
# и достать номер живого человека (прецедент был — ловушка иногда ловит и
# живых посетителей, не только ботов), но не хранить чужие телефоны вечно.
# Дефолт 14.
LEAD_QUARANTINE_TTL_DAYS=

# ── Lead form demo mode ─────────────────────────────────────────────────────
# '1' или 'true' → src/lib/lead-form.ts пропускает сетевой вызов целиком,
# печатает громкий console.warn («заявка НЕ отправлена») — лид не теряется
# молча — и всё равно ведёт на /thanks/, как при успешной отправке. Нужен
# для демо заказчику, пока бэкенд не подключён. В проде ОБЯЗАН быть пустым
# (или '0'/'false').
PUBLIC_LEAD_DEMO_MODE=

# ============================================================================
#  МОДУЛЬ БОТОВ (Telegram + MAX) — ПЕРЕМЕННЫЕ ЖИВУТ ЗДЕСЬ ЖЕ
# ----------------------------------------------------------------------------
#  Отдельных .env у ботов НЕТ намеренно. Freim Deploy раздаёт переменные
#  проекта ВСЕМ сервисам сразу, поэтому второй набор рядом с bot.py — это не
#  удобство, а второе место, где секрет, каталог данных и номер счётчика
#  однажды разъедутся. Боты сами находят этот файл, поднимаясь вверх от
#  bot.py (нестандартная раскладка каталогов → SITE_ENV_FILE=/путь/к/.env).
#  Какой файл прочитан — первой строкой в логе бота при старте.
#
#  Блок спит целиком, пока сайт статический: боты — часть лид-пайплайна v2
#  (docs/recipes/lead-pipeline.md). Пустой токен ботов НЕ ломает — они
#  поднимаются в режиме waiting_for_token и отвечают на /health.
#
#  ⚠️ У переменных, которые у ботов ОБЯЗАНЫ различаться, имя с префиксом:
#  TELEGRAM_NOTIFY_PORT против MAX_NOTIFY_PORT. Безпрефиксный NOTIFY_PORT
#  здесь задавать НЕЛЬЗЯ — общий файл достанется обоим, второй бот не займёт
#  порт и умрёт на старте.
# ============================================================================

# ─── Telegram ───────────────────────────────────────────────────────────────
# Токен от @BotFather (команда /newbot).
TELEGRAM_BOT_TOKEN=
# chat_id рабочей группы: добавить бота в группу и отправить там /id
# (у супергрупп число отрицательное, вида -100…).
TELEGRAM_GROUP_CHAT_ID=
# ⚠️ Порт УНИКАЛЕН НА СЕРВЕР, а не на проект: loopback один на всю машину.
# 8091/8092 — дефолт для ПЕРВОГО проекта на хосте; второму выдайте свою
# пару (8093/8094 и т.д.), иначе оба его бота упадут с «address already
# in use» и уронят весь деплой. Реестр — docs/recipes/lead-pipeline.md §6.1.
TELEGRAM_NOTIFY_PORT=8091

# ─── MAX (max.ru) ───────────────────────────────────────────────────────────
# Токен из кабинета партнёра dev.max.ru.
MAX_TOKEN=
# chat_id группы MAX: добавить бота АДМИНОМ в группу → в логах появится
# «Обнаружен chat_id группы: … (событие bot_added)».
MAX_CHAT_ID=
MAX_NOTIFY_PORT=8092

# ─── Общее для обоих ботов ──────────────────────────────────────────────────
# Интерфейс приёмника. Только loopback — наружу торчать не должен.
NOTIFY_HOST=127.0.0.1
# Заголовок карточки: «📩 Новая заявка — <BRAND_NAME>». Пусто → «Сайт».
BRAND_NAME=
# Домены сайта через запятую. У своих страниц карточка показывает только путь
# (`/uslugi/`), у чужих — домен целиком. Пусто — безопасно, просто длиннее.
SITE_HOSTS=
# Подписи источника лида: значение data-lead-source формы → текст в карточке.
# JSON-объект; кривой JSON бота НЕ роняет (warning в лог, работа на дефолте).
#   LEAD_SOURCE_LABELS={"form": "форма на сайте", "popup": "попап"}
LEAD_SOURCE_LABELS=
# Подписи типа заявки (поле `type` формы). Формы без поля `type` строку
# «Тип: …» просто не рисуют.
#   LEAD_TYPE_LABELS={"repair": "Ремонт", "design": "Дизайн-проект"}
LEAD_TYPE_LABELS=
# Часовой пояс времени в карточках: МСК = UTC+3 круглый год (без переходов).
TZ_OFFSET_HOURS=3

# ─── Яндекс.Метрика: серверные цели квалификации ────────────────────────────
# Номер счётчика боты берут из PUBLIC_YANDEX_METRIKA_ID (блок аналитики
# вверху) — отдельно задавать не нужно. Переменная ниже нужна, только если
# цели должны уходить в ДРУГОЙ счётчик.
METRIKA_COUNTER_ID=
# Measurement Protocol: Метрика → Настройки счётчика → Безопасность и
# использование данных → Measurement Protocol. Канал цели lead_flushed
# (мгновенно, окно 12 ч) и фолбэк для кнопок квалификации.
METRIKA_MP_TOKEN=
# OAuth для Offline Conversions API — ОСНОВНОЙ канал кнопок квалификации
# (окно 21 день: менеджер квалифицирует через часы и дни, MP столько не
# живёт). oauth.yandex.ru → приложение → доступ metrika:offline_data →
# токен под аккаунтом с правом редактирования счётчика. Живёт 1 год.
METRIKA_OAUTH_TOKEN=

# ─── Очередь недоставленного (пусто = дефолты 300 с / 24 ч) ─────────────────
OUTBOX_RETRY_SECONDS=
OUTBOX_GIVE_UP_HOURS=

# ─── Watchdog сайта у telegram-бота (по умолчанию ВЫКЛЮЧЕН) ─────────────────
# Алерты НИКОГДА не идут в группу заявок: там работают менеджеры. Нужен
# ОТДЕЛЬНЫЙ служебный чат — MONITOR_CHAT_ID. Пусто → watchdog не запускается.
# Подробно: docs/recipes/monitoring.md.
MONITOR_CHAT_ID=
# Пусто = watchdog выключен. Свой домен с завершающим слешем:
#   HEALTH_URL=https://<домен>/api/health/
HEALTH_URL=
# Интервал проверки (300 с), провалов подряд до алерта (2), пауза после
# старта (120 с) — пусто означает эти дефолты.
HEALTH_INTERVAL=
HEALTH_FAILS_BEFORE_ALERT=
HEALTH_START_DELAY=

# ─── Редко нужное: транспорт MAX и синхронизация ботов ──────────────────────
# Базовый URL MAX Bot API. Пусто = https://botapi.max.ru (публичный хост,
# обычный Let's Encrypt — работает из коробки).
MAX_API_BASE=
# PEM корневого CA Минцифры. НЕ нужен для botapi.max.ru; требуется, только
# если выше указан внутренний platform-api2.max.ru.
RUSSIAN_TRUSTED_CA_PATH=
# Куда бот сообщает соседу о нажатом статусе, чтобы карточка в другом
# мессенджере перестала выглядеть необработанной. Пусто → адрес собирается
# сам из порта соседа; задавать вручную почти никогда не нужно.
TELEGRAM_PEER_STATUS_URL=
MAX_PEER_STATUS_URL=

# ── Лёгкая альтернатива пайплайну: api/contact.ts (v1) ──────────────────────
# ⚠️ ЛИБО модуль ботов выше, ЛИБО это — не одновременно. Здесь сайт сам постит
# заявку в Telegram: без воркеров, без файлового хранилища и без кнопок
# квалификации. Нужен hybrid/server и разбуженный роут src/pages/api/contact.ts.
#
# Токен берётся из TELEGRAM_BOT_TOKEN выше — он общий. Отличается только
# получатель: у v1 это TELEGRAM_CHAT_ID, у модуля ботов —
# TELEGRAM_GROUP_CHAT_ID. Две разные переменные намеренно: так включённый
# роут v1 не начнёт молча дублировать заявки в группу менеджеров.
TELEGRAM_CHAT_ID=
# Либо вообще без своего бэкенда: URL формы Formspree/Getform/Web3Forms.
FORMSPREE_ENDPOINT=

# ── IndexNow (search-engine ping on deploy) ─────────────────────────────────
# Generate a random key, save it as public/<key>.txt, and put it here.
# Notifies Yandex + Bing about changed URLs after each build.
INDEXNOW_KEY=
# PUBLIC_-дубликат для панелей деплоя, которые прокидывают в сборку сервиса
# ТОЛЬКО переменные с префиксом PUBLIC_*: ключ IndexNow и так публичен по
# протоколу (отдаётся всем на https://<домен>/<key>.txt), так что префикс
# ничего не палит. scripts/indexnow-notify.mjs читает INDEXNOW_KEY, а если
# он пуст — берёт этот. Достаточно заполнить один из двух.
PUBLIC_INDEXNOW_KEY=

# ── Maps ────────────────────────────────────────────────────────────────────
# Optional API key if you use the JS Maps API island instead of an iframe.
PUBLIC_MAPS_API_KEY=
