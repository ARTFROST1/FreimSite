---
/**
 * ============================================================================
 *  LegalLayout — общая обёртка трёх правовых документов сайта.
 * ----------------------------------------------------------------------------
 *  Один макет на /privacy-policy/, /soglasie-na-obrabotku-dannykh/ и /terms/:
 *  шапка с крошками, дата редакции, оглавление, типографика документа и
 *  перелинковка между документами. Страницы содержат ТОЛЬКО текст — никакой
 *  общей разметки они не дублируют.
 *
 *  ПОЧЕМУ ОТДЕЛЬНЫЙ МАКЕТ, А НЕ КЛАССЫ В РАЗМЕТКЕ СТРАНИЦ:
 *  у юридического текста своя типографика (плотные списки, таблицы, нумерация
 *  разделов), которой больше нигде на сайте нет, и плагина `typography` в
 *  проекте нет. Держать эти правила в одном месте дешевле, чем развешивать
 *  Tailwind-классы на каждом из ~90 абзацев трёх документов.
 *
 *  ОГЛАВЛЕНИЕ БЕЗ ДУБЛИРОВАНИЯ ЗАГОЛОВКОВ: страница объявляет разделы одним
 *  объектом `{ anchor: 'заголовок' }` и передаёт его в `sections`; тот же
 *  объект она использует в разметке (`<h2 id="general">{S.general}</h2>`).
 *  Порядок ключей объекта = порядок разделов, поэтому оглавление физически
 *  не может разъехаться с текстом.
 *
 *  NOINDEX: макет сам noindex НЕ ставит — публикация политики в открытом
 *  доступе является требованием ч. 2 ст. 18.1 152-ФЗ, и правовые страницы
 *  должны индексироваться (sitemap-фильтр в astro.config.mjs их включает
 *  намеренно). Но пока `LEGAL.placeholder === true`, все значения в
 *  src/config/legal.ts — вымышленные плейсхолдеры, поэтому noindex включён
 *  через этот флаг. Убрать noindex = заполнить legal.ts реальными данными и
 *  переключить там `placeholder` в `false` — отдельной правки здесь не нужно.
 * ============================================================================
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { LEGAL } from '../config/legal';
import { getEntry } from 'astro:content';

/** Ключ документа. Из него берутся крошки, дата редакции и перелинковка. */
export type LegalDoc = 'privacy' | 'consent' | 'terms';

/** Каталог правовых страниц — единственное место, где живут их адреса и
 *  названия. Добавляешь документ — добавляешь запись здесь, и он сам
 *  появляется в блоке «Другие документы» на остальных страницах. */
export const LEGAL_DOCS: Record<
  LegalDoc,
  { href: string; title: string; short: string; note: string }
> = {
  privacy: {
    href: '/privacy-policy/',
    title: 'Политика конфиденциальности',
    short: 'Политика конфиденциальности',
    note: 'Какие данные собирает сайт, зачем, как долго хранит и кому передаёт.',
  },
  consent: {
    href: '/soglasie-na-obrabotku-dannykh/',
    title: 'Согласие на обработку персональных данных',
    short: 'Согласие на обработку данных',
    note: 'Текст согласия, которое вы даёте, отправляя форму на сайте, и порядок его отзыва.',
  },
  terms: {
    href: '/terms/',
    title: 'Пользовательское соглашение',
    short: 'Пользовательское соглашение',
    note: 'Условия использования сайта, статус цен в каталоге и права на материалы.',
  },
};

interface Props {
  doc: LegalDoc;
  title: string;
  description: string;
  /** Подзаголовок под H1 — одно предложение о том, что это за документ. */
  lead?: string;
  /** `{ anchor: 'Заголовок раздела' }` в порядке следования. См. доккоммент. */
  sections: Record<string, string>;
  ogImage?: string;
}

const { doc, title, description, lead, sections, ogImage } = Astro.props;

const meta = LEGAL_DOCS[doc];
/** Даты редакций правит клиент в портале (коллекция `legal`), поэтому они
 *  берутся из контента, а не из LEGAL_DOCS выше — там осталась только
 *  структура (адреса, названия, аннотации). */
const docDate = (await getEntry('legal', 'main'))!.data.dates[doc];
const crumbs = [{ name: 'Главная', url: '/' }, { name: meta.short }];
const others = (Object.keys(LEGAL_DOCS) as LegalDoc[]).filter((k) => k !== doc);
const toc = Object.entries(sections);
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  breadcrumbs={crumbs}
  noindex={LEGAL.placeholder}
>
  <main class="section">
    <div class="container-page">
      <Breadcrumbs items={crumbs} class="mb-6" />

      <header class="max-w-3xl">
        <p class="eyebrow mb-3">Правовые документы</p>
        <h1 class="font-heading text-3xl font-extrabold leading-tight md:text-4xl">{meta.title}</h1>
        {lead && <p class="mt-4 text-lg text-muted">{lead}</p>}
        <p class="mt-4 text-sm text-muted">
          Редакция от <span data-cms={`legal::dates.${doc}`}>{docDate}</span> г. Действующая версия
          документа всегда размещена на этой странице.
        </p>
      </header>

      <div class="legal-grid mt-10">
        {
          toc.length > 1 && (
            <nav class="legal-toc" aria-label="Содержание документа">
              <p class="eyebrow mb-3">Содержание</p>
              <ol class="space-y-1.5 text-sm">
                {toc.map(([anchor, heading]) => (
                  <li>
                    <a href={`#${anchor}`} class="text-muted transition-colors hover:text-accent">
                      {heading}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <article class="legal-doc">
          <slot />
        </article>
      </div>

      <aside class="mt-16 border-t border-line pt-10">
        <p class="eyebrow mb-4">Другие документы</p>
        <div class="grid gap-4 md:grid-cols-2">
          {
            others.map((key) => (
              <a href={LEGAL_DOCS[key].href} class="legal-card" rel="nofollow">
                <span class="font-heading text-lg font-bold text-ink">{LEGAL_DOCS[key].short}</span>
                <span class="mt-1.5 block text-sm text-muted">{LEGAL_DOCS[key].note}</span>
                <span class="mt-3 block text-sm font-semibold text-accent">
                  Читать <span class="tip" aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </aside>

      <a href="/" class="btn btn-ghost mt-10 text-sm">← Вернуться на главную</a>
    </div>
  </main>
</BaseLayout>

<style>
  /* Оглавление липнет сбоку только там, где для него есть колонка. На узких
     экранах это обычный блок над текстом. */
  .legal-grid {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
  }
  /* Grid-элемент по умолчанию получает `min-width: auto`, то есть не может
     стать уже min-content своего содержимого. Внутри документа есть таблицы с
     `min-width: 460px` (см. `.legal-table` ниже): без этого правила на узком
     экране раздувался бы сам грид, и горизонтально уезжала бы вся страница —
     собственный `overflow-x: auto` таблицы этого не предотвращает. На десктопе
     колонку текста страхует `minmax(0, 1fr)` ниже, одноколоночную раскладку —
     только это правило. */
  .legal-grid > * {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .legal-grid {
      grid-template-columns: 260px minmax(0, 1fr);
      align-items: start;
    }
  }
  .legal-toc {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: 20px;
  }
  @media (min-width: 1024px) {
    .legal-toc {
      position: sticky;
      /* Шапка сайта перекрывает верх вьюпорта — держим зазор под неё. */
      top: 96px;
      max-height: calc(100vh - 128px);
      overflow-y: auto;
    }
  }
  .legal-card {
    display: block;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: 20px 24px;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .legal-card:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-paper));
  }
  .legal-card .tip {
    display: inline-block;
    transition: transform 0.25s ease;
  }
  .legal-card:hover .tip {
    transform: translateX(4px);
  }

  /* ── Типографика документа ──
     Текст приходит слотом, поэтому селекторы глобальные: scoped-хэши Astro
     на чужую разметку не навешиваются. Область ограничена `.legal-doc`,
     наружу правила не текут. */
  .legal-doc {
    max-width: 68ch;
    color: var(--color-muted);
    font-size: 15.5px;
    line-height: 1.75;
  }
  @media (min-width: 768px) {
    .legal-doc {
      font-size: 16px;
    }
  }
  .legal-doc :global(section + section) {
    margin-top: 2.5rem;
  }
  .legal-doc :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--color-ink);
    margin-bottom: 1rem;
    /* Якорь не должен уезжать под шапку при переходе из оглавления. */
    scroll-margin-top: 96px;
  }
  .legal-doc :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .legal-doc :global(p) {
    margin-bottom: 1rem;
  }
  .legal-doc :global(p:last-child) {
    margin-bottom: 0;
  }
  .legal-doc :global(ul),
  .legal-doc :global(ol) {
    margin: 0 0 1rem;
    padding-left: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .legal-doc :global(ul) {
    list-style: disc;
  }
  .legal-doc :global(ol) {
    list-style: decimal;
  }
  .legal-doc :global(li::marker) {
    color: var(--color-accent);
  }
  .legal-doc :global(strong) {
    color: var(--color-ink);
    font-weight: 700;
  }
  .legal-doc :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-doc :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  /* Имена cookie и UTM-меток — техстрока внутри юридического текста.
     БЕЗ подложки и горизонтальных отступов: у чипа с `padding: 1px 5px`
     правый отступ шириной почти с пробел вклинивался бы перед запятой в
     перечислениях («utm_source , utm_medium»). Достаточно моноширинного
     начертания и цвета основного текста. */
  .legal-doc :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
    color: var(--color-ink);
    word-break: break-word;
  }
  /* Таблицы («цель → правовое основание», реквизиты, cookie) на мобиле
     скроллятся внутри своей обёртки, а не растягивают страницу. */
  .legal-doc :global(.legal-table) {
    overflow-x: auto;
    margin-bottom: 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
  }
  .legal-doc :global(table) {
    width: 100%;
    min-width: 460px;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .legal-doc :global(th) {
    text-align: left;
    font-weight: 700;
    color: var(--color-ink);
    background: var(--color-surface);
  }
  .legal-doc :global(th),
  .legal-doc :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
  }
  .legal-doc :global(tr:last-child td) {
    border-bottom: 0;
  }
  /* Блок реквизитов оператора — определения, а не список с маркерами. */
  .legal-doc :global(.legal-details) {
    display: grid;
    gap: 8px 20px;
    margin-bottom: 1rem;
    padding: 18px 20px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }
  @media (min-width: 640px) {
    .legal-doc :global(.legal-details) {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    }
  }
  .legal-doc :global(.legal-details dt) {
    color: var(--color-muted);
  }
  .legal-doc :global(.legal-details dd) {
    color: var(--color-ink);
    font-weight: 600;
    margin: 0;
  }
  @media (max-width: 639px) {
    .legal-doc :global(.legal-details dd) {
      margin-bottom: 6px;
    }
  }
</style>
