---
/**
 * Lightbox — vanilla fullscreen image viewer, zero dependencies
 * (showcase-reference pattern).
 *
 * Fully DECOUPLED from galleries via a document-level CustomEvent:
 *   document.dispatchEvent(new CustomEvent('open-lightbox', {
 *     detail: { images: ['/images/1.webp', ...], startIndex: 0 }
 *   }));
 *
 * Plus a declarative shortcut: any element with `data-lightbox` opens a group
 * built from all [data-lightbox] elements sharing its data-lightbox-group
 * (defaults to 'default'). The value of data-lightbox is the FULL-SIZE url
 * (the element itself can render a small preview).
 *
 * Features: keyboard (Esc ← →), touch swipe, double-click/double-tap zoom ×2,
 * neighbor preloading, scroll lock, View-Transitions-safe idempotent init.
 * Render ONCE per page (e.g. in BaseLayout or the page that needs it).
 */
---
<!-- `inert`, а не только aria-hidden: закрытый лайтбокс без него держит свои
     три кнопки (закрыть/назад/вперёд) в порядке табуляции — клавиатурный
     посетитель проваливается в невидимый диалог посреди страницы (axe:
     aria-hidden-focus). `inert` вынимает поддерево и из фокуса, и из дерева
     доступности; снимается в open(), возвращается в close(). -->
<div id="lightbox" class="lightbox" aria-hidden="true" inert>
  <button class="lightbox-close" aria-label="Закрыть">×</button>
  <button class="lightbox-prev" aria-label="Предыдущее">‹</button>
  <div class="lightbox-wrap">
<!-- src is a 1px transparent GIF until JS swaps in the real image on open -->
    <img class="lightbox-img" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" />
  </div>
  <button class="lightbox-next" aria-label="Следующее">›</button>
  <div class="lightbox-counter"></div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.92);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .lightbox.active {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox-wrap {
    max-width: 92vw;
    max-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-img {
    max-width: 92vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 8px;
    transition: transform 0.25s ease;
    cursor: zoom-in;
  }
  .lightbox-img.zoomed {
    transform: scale(2);
    cursor: zoom-out;
  }
  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    z-index: 2;
    color: rgba(255, 255, 255, 0.85);
    background: none;
    border: none;
    cursor: pointer;
    font-size: 2.5rem;
    line-height: 1;
    padding: 0.5rem 1rem;
    transition: color 0.15s ease;
  }
  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    color: #fff;
  }
  .lightbox-close { top: 0.5rem; right: 0.5rem; }
  .lightbox-prev { left: 0.25rem; top: 50%; transform: translateY(-50%); }
  .lightbox-next { right: 0.25rem; top: 50%; transform: translateY(-50%); }
  .lightbox-counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.875rem;
  }
</style>

<script is:inline>
  (function () {
    if (window.__lightboxInit) return;
    window.__lightboxInit = true;

    var images = [];
    var index = 0;

    function el() { return document.getElementById('lightbox'); }
    function img() { return el() && el().querySelector('.lightbox-img'); }

    function wrapIdx(i) {
      var len = images.length;
      return ((i % len) + len) % len;
    }

    function preloadNeighbors() {
      [index - 1, index + 1].forEach(function (i) {
        if (!images.length) return;
        var pre = new Image();
        pre.src = images[wrapIdx(i)];
      });
    }

    function show(i) {
      var root = el();
      var image = img();
      if (!root || !image || !images.length) return;
      index = wrapIdx(i);
      image.classList.remove('zoomed');
      image.src = images[index];
      var counter = root.querySelector('.lightbox-counter');
      if (counter) counter.textContent = (index + 1) + ' / ' + images.length;
      preloadNeighbors();
    }

    function open(list, start) {
      var root = el();
      if (!root || !list || !list.length) return;
      images = list;
      show(start || 0);
      root.classList.add('active');
      root.setAttribute('aria-hidden', 'false');
      root.removeAttribute('inert');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      var root = el();
      if (!root) return;
      root.classList.remove('active');
      root.setAttribute('aria-hidden', 'true');
      root.setAttribute('inert', '');
      document.body.style.overflow = '';
    }

    function isActive() {
      var root = el();
      return root && root.classList.contains('active');
    }

    // ── Event API (any component can dispatch this) ──
    document.addEventListener('open-lightbox', function (e) {
      var d = e.detail || {};
      open(d.images || [], d.startIndex || 0);
    });

    // ── Declarative API: [data-lightbox="full-url"] elements ──
    document.addEventListener('click', function (e) {
      var t = e.target && e.target.closest && e.target.closest('[data-lightbox]');
      if (!t) return;
      e.preventDefault();
      var group = t.getAttribute('data-lightbox-group') || 'default';
      var members = Array.prototype.slice.call(
        document.querySelectorAll('[data-lightbox][data-lightbox-group="' + group + '"]')
      );
      if (!members.length || group === 'default') {
        members = Array.prototype.slice.call(
          document.querySelectorAll('[data-lightbox]:not([data-lightbox-group]), [data-lightbox][data-lightbox-group="default"]')
        );
      }
      var urls = members.map(function (m) { return m.getAttribute('data-lightbox'); });
      open(urls, Math.max(0, members.indexOf(t)));
    });

    // ── Controls (document-level, bound once) ──
    document.addEventListener('click', function (e) {
      if (!isActive()) return;
      var t = e.target;
      if (t.closest && t.closest('.lightbox-close')) close();
      else if (t.closest && t.closest('.lightbox-prev')) show(index - 1);
      else if (t.closest && t.closest('.lightbox-next')) show(index + 1);
      else if (t.id === 'lightbox' || (t.classList && t.classList.contains('lightbox-wrap'))) close();
    });

    document.addEventListener('keydown', function (e) {
      if (!isActive()) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(index - 1);
      else if (e.key === 'ArrowRight') show(index + 1);
    });

    // ── Touch swipe + double-tap zoom ──
    var touchX = 0, touchY = 0, touchT = 0, lastTap = 0;
    document.addEventListener('touchstart', function (e) {
      if (!isActive()) return;
      var t = e.touches[0];
      touchX = t.clientX; touchY = t.clientY; touchT = Date.now();
    }, { passive: true });
    document.addEventListener('touchend', function (e) {
      if (!isActive()) return;
      var t = e.changedTouches[0];
      var dx = t.clientX - touchX;
      var dy = t.clientY - touchY;
      var dt = Date.now() - touchT;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5 && dt < 500) {
        show(dx < 0 ? index + 1 : index - 1);
        return;
      }
      var now = Date.now();
      if (now - lastTap < 300) {
        var image = img();
        image && image.classList.toggle('zoomed');
      }
      lastTap = now;
    }, { passive: true });

    // Double-click zoom (desktop).
    document.addEventListener('dblclick', function (e) {
      if (!isActive()) return;
      if (e.target && e.target.classList && e.target.classList.contains('lightbox-img')) {
        e.target.classList.toggle('zoomed');
      }
    });

    // Close on SPA navigation so the overlay never leaks across pages.
    document.addEventListener('astro:before-swap', close);
  })();
</script>
