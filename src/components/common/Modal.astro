---
/**
 * Modal — generic-модалка на нативном `<dialog>` (showModal → фокус-трап,
 * Escape и ::backdrop бесплатно от браузера).
 *
 * Открытие:
 *   • декларативно — любой элемент с `data-modal-open="<id>"`:
 *       <button data-modal-open="promo-modal">Подробнее</button>
 *   • программно — CustomEvent на document:
 *       document.dispatchEvent(new CustomEvent('app:modal-open', { detail: { id: 'promo-modal' } }));
 *
 * Закрытие: крестик, Escape (нативный cancel→close диалога), клик по
 * backdrop, любой элемент с `data-modal-close` внутри модалки.
 *
 * Вся логика — ОДИН делегированный набор слушателей на document
 * (`window.__modalInit`), поставленный один раз за жизнь документа. Документ
 * переживает свап `<body>` при SPA-навигации ClientRouter, поэтому
 * пере-инициализация на `astro:page-load` не нужна — новые триггеры и
 * `<dialog>` из свапнутого body подхватываются делегированием сами.
 * На `astro:before-swap` открытые диалоги закрываются, чтобы скролл-лок
 * не утёк на следующую страницу.
 *
 * Отсутствующая цель (битый id в CMS-превью, модалка не отрендерена) — не
 * ошибка: клик тихо игнорируется, в dev — console.warn.
 *
 * Скролл-лок: `overflow: hidden` на body, пока открыт ХОТЯ БЫ ОДИН dialog
 * на странице (native `close` ловится capture-фазой — событие не всплывает).
 *
 * Анимация появления — CSS `@starting-style`, только под
 * `prefers-reduced-motion: no-preference`; reduce-посетитель получает
 * мгновенный показ. Exit-анимации нет сознательно: она требует перехвата
 * нативного Escape (preventDefault на cancel) и таймеров по
 * animationDuration — ломкость не стоит 200 мс красоты.
 *
 * Usage:
 *   <Modal id="promo-modal" title="Акция месяца" size="sm">
 *     <p>Любой контент через slot.</p>
 *     <button class="btn btn-primary" data-modal-close>Понятно</button>
 *   </Modal>
 */

interface Props {
  /** Уникальный id диалога — на него ссылаются триггеры `data-modal-open`. */
  id: string;
  /** Заголовок. Без него модалка получает aria-label (см. ariaLabel). */
  title?: string;
  /** Ширина панели. */
  size?: 'sm' | 'md' | 'lg';
  /** aria-label крестика. */
  closeLabel?: string;
  /** aria-label самого диалога, когда title не задан. */
  ariaLabel?: string;
  /** Дополнительные классы на <dialog>. */
  class?: string;
}

const {
  id,
  title,
  size = 'md',
  closeLabel = 'Закрыть',
  ariaLabel = 'Диалоговое окно',
  class: className,
} = Astro.props;

const titleId = title ? `${id}-title` : undefined;
---

<dialog
  id={id}
  class:list={['app-modal', `app-modal--${size}`, className]}
  data-modal
  aria-labelledby={titleId}
  aria-label={title ? undefined : ariaLabel}
>
  <div class="modal-panel">
    <button type="button" class="modal-close" data-modal-close aria-label={closeLabel}>
      ×
    </button>
    {title && (
      <h2 class="modal-title" id={titleId} data-modal-title tabindex="-1">
        {title}
      </h2>
    )}
    <slot />
  </div>
</dialog>

<script>
  // Один набор document-слушателей на весь сайт (правило A из
  // docs/recipes/animations-motion.md §2). Бандл-скрипт Astro и так
  // исполняется однажды, но флаг делает инициализацию идемпотентной при
  // любом способе доставки скрипта. Флаг объявлен в env.d.ts (общий дом).
  if (!window.__modalInit) {
    window.__modalInit = true;

    /** body.overflow ← «открыт ли хотя бы один <dialog> на странице». */
    const syncScrollLock = (): void => {
      document.body.style.overflow = document.querySelector('dialog[open]') ? 'hidden' : '';
    };

    const openModal = (id: string): void => {
      const dialog = document.getElementById(id);
      if (!(dialog instanceof HTMLDialogElement)) {
        // CMS-превью/битый id — не повод ронять страницу.
        if (import.meta.env.DEV) {
          console.warn(`[Modal] диалог "#${id}" не найден или не <dialog>`);
        }
        return;
      }
      if (dialog.open) return;
      try {
        dialog.showModal();
      } catch {
        return; // не в DOM / уже открыт не-модально — тихо выходим
      }
      syncScrollLock();
      // Фокус на заголовок (паттерн accessible-astro): скринридер сразу
      // читает контекст. Без заголовка нативный showModal сам фокусирует
      // первый фокусируемый элемент (крестик).
      dialog.querySelector<HTMLElement>('[data-modal-title]')?.focus();
    };

    // ── Делегированные клики: триггеры, крестик/data-modal-close, backdrop ──
    document.addEventListener('click', (e) => {
      const t = e.target as Element | null;
      if (!t || typeof t.closest !== 'function') return;

      const opener = t.closest('[data-modal-open]');
      if (opener) {
        const id = opener.getAttribute('data-modal-open');
        if (id) openModal(id);
        return;
      }

      const closer = t.closest('[data-modal-close]');
      if (closer) {
        const dialog = closer.closest('dialog');
        if (dialog && dialog.open) {
          dialog.close();
          syncScrollLock();
        }
        return;
      }

      // Клик по backdrop: у открытого модального диалога клик по ::backdrop
      // приходит с target = сам <dialog>; панель занимает диалог целиком
      // (padding: 0), так что «мимо панели» === «по самому диалогу».
      if (t instanceof HTMLDialogElement && t.hasAttribute('data-modal') && t.open) {
        t.close();
        syncScrollLock();
      }
    });

    // ── Программное открытие ──
    document.addEventListener('app:modal-open', (e) => {
      const id = (e as CustomEvent<{ id?: unknown }>).detail?.id;
      if (typeof id === 'string') openModal(id);
    });

    // Нативные пути закрытия (Escape → cancel → close, form method="dialog"):
    // событие `close` не всплывает, поэтому ловим его capture-фазой.
    document.addEventListener('close', syncScrollLock, true);

    // SPA-навигация: закрыть всё и вернуть скролл, чтобы лок не утёк.
    document.addEventListener('astro:before-swap', () => {
      document
        .querySelectorAll<HTMLDialogElement>('dialog[open]')
        .forEach((d) => d.close());
      document.body.style.overflow = '';
    });
  }
</script>

<style>
  .app-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(calc(100% - 2rem), var(--modal-max, 32rem));
    max-height: min(calc(100dvh - 2rem), 44rem);
    padding: 0; /* панель занимает диалог целиком → target===dialog значит backdrop */
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 0 24px 64px -16px rgb(0 0 0 / 0.35);
    overscroll-behavior: contain;
  }
  .app-modal--sm { --modal-max: 24rem; }
  .app-modal--md { --modal-max: 32rem; }
  .app-modal--lg { --modal-max: 46rem; }

  .app-modal::backdrop {
    background: rgb(0 0 0 / 0.55);
  }

  .modal-panel {
    position: relative;
    max-height: inherit;
    overflow-y: auto;
    padding: 1.5rem;
  }
  @media (min-width: 768px) {
    .modal-panel {
      padding: 2rem;
    }
  }

  .modal-title {
    margin: 0;
    padding-right: 2.25rem; /* не залезать под крестик */
    font-size: 1.25rem;
    font-weight: 700;
    outline: none; /* программный focus() — без рамки; :focus-visible не сработает */
  }

  .modal-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: 9999px;
    background: transparent;
    color: var(--color-muted);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .modal-close:hover {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  /* Появление — только когда движение разрешено (правило §9 рецепта). */
  @media (prefers-reduced-motion: no-preference) {
    .app-modal[open] {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .app-modal[open]::backdrop {
      opacity: 1;
      transition: opacity 0.25s ease;
    }
    @starting-style {
      .app-modal[open] {
        opacity: 0;
        transform: translateY(12px);
      }
      .app-modal[open]::backdrop {
        opacity: 0;
      }
    }
  }
</style>
