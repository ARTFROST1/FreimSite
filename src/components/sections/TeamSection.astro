---
/**
 * TEAM — карточки людей. Данные из коллекции `team`
 * (src/content/home/team.json), заголовки — `sections.team`, оба редактируются
 * в портале (см. docs/CMS-BUILDING.md). 0 KB JS.
 *
 * ВАРИАНТЫ (`variant`) — только раскладка, данные и `data-cms` одинаковые:
 *   - `grid` (default) — вертикальные карточки 2/4 в ряд, фото сверху 1:1;
 *   - `row`  — компактные горизонтальные карточки, фото-квадрат слева,
 *              2 в ряд на десктопе (для страницы «О нас», сайдбара и т. п.).
 *
 * ФОТО НЕОБЯЗАТЕЛЬНО. `photo` пусто → нейтральный силуэт в `.ph.ph-slot`
 * (фон/размер — global.css). Силуэт нарисован инлайном, а не через
 * `<use href="#sl-…">` из `SilhouetteSprite`: спрайт подключается «один раз
 * на страницу» вручную, а эта секция должна работать на любой странице без
 * обязательного соседа. Когда фото есть — `<ContentImage>` (lazy, srcset) с
 * `data-cms` + `data-fd-attr="src"` на самой картинке, как у
 * `StackedShowcase`.
 *
 * `bio` — тоже необязательное: абзац не рендерится, если поле пустое, и
 * рот-гвард (`annotations.test.ts`) проверяет его только у тех, у кого он
 * заполнен.
 */
import { getCollection, getEntry } from 'astro:content';
import ContentImage from '../ui/ContentImage.astro';

const MEMBERS = (await getCollection('team')).map((e) => e.data);
const T = (await getEntry('sections', 'main'))!.data.team;

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  /** `grid` — карточки в сетке; `row` — горизонтальные компактные. */
  variant?: 'grid' | 'row';
  /** См. `cmsScope` у IntroSection — тот же механизм переопределения. */
  cmsScope?: string;
  /** `id` секции для якоря. */
  id?: string;
}
const {
  eyebrow = T.eyebrow,
  title = T.title,
  subtitle = T.subtitle,
  variant = 'grid',
  cmsScope = 'sections::team',
  id = 'team',
} = Astro.props;
---
<section id={id} class="section">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow mb-3" data-cms={`${cmsScope}.eyebrow`}>{eyebrow}</p>
      <h2 class="text-3xl font-bold md:text-4xl" data-cms={`${cmsScope}.title`}>{title}</h2>
      <p class="mt-4 text-muted" data-cms={`${cmsScope}.subtitle`}>{subtitle}</p>
    </div>

    <ul
      class:list={[
        'mt-12 grid list-none gap-6 p-0',
        variant === 'grid' ? 'sm:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-2',
      ]}
    >
      {
        MEMBERS.map((m) => (
          <li class:list={['team-card card', variant === 'row' && 'team-card-row']}>
            <div class="team-photo">
              {m.photo ? (
                <ContentImage
                  src={m.photo}
                  alt={m.name}
                  widths={[320, 640, 960]}
                  sizes={variant === 'grid' ? '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw' : '112px'}
                  width={640}
                  height={640}
                  class="h-full w-full object-cover"
                  data-cms={`team:${m.id}:photo`}
                  data-fd-attr="src"
                />
              ) : (
                <span class="ph ph-slot team-ph" role="img" aria-label={`Фото: ${m.name}`}>
                  <svg viewBox="0 0 200 150" style="color:var(--color-accent)" aria-hidden="true">
                    <circle cx="100" cy="52" r="30" fill="currentColor" />
                    <path d="M40 150v-14c0-26 27-42 60-42s60 16 60 42v14Z" fill="currentColor" />
                    <path d="M84 96l16 22 16-22" fill="rgba(255,255,255,.28)" />
                  </svg>
                </span>
              )}
            </div>
            <div class="team-body">
              <h3 class="text-lg font-semibold" data-cms={`team:${m.id}:name`}>{m.name}</h3>
              <p class="mt-1 text-sm text-accent" data-cms={`team:${m.id}:role`}>{m.role}</p>
              {m.bio && <p class="mt-3 text-sm text-muted" data-cms={`team:${m.id}:bio`}>{m.bio}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
  }
  .team-photo {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-surface);
  }
  .team-ph {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }
  .team-body {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  /* ---- variant="row": фото-квадрат слева, текст справа ---- */
  .team-card-row {
    flex-direction: row;
    align-items: stretch;
  }
  .team-card-row .team-photo {
    flex: 0 0 7rem;
    width: 7rem;
    aspect-ratio: auto;
    min-height: 7rem;
  }
  .team-card-row .team-body {
    padding: 1rem 1.25rem;
    min-width: 0;
  }
  @media (max-width: 480px) {
    .team-card-row .team-photo {
      flex-basis: 5.5rem;
      width: 5.5rem;
      min-height: 5.5rem;
    }
  }
</style>
