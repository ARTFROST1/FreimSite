        "enabled": true,
        "format": "markdown",
        "label": "Текст статьи"
      },
      "itemSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Заголовок статьи"
          },
