{
  "name": "freim-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Astro 7 starter: SEO, analytics, islands, content collections. Reusable skeleton for client sites.",
  "scripts": {
    "dev": "astro dev",
    "generate:content-schema": "tsx scripts/generate-content-schema.ts",
    "prebuild": "npm run generate:content-schema",
    "build": "astro build",
    "postbuild": "node scripts/indexnow-notify.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "astro check",
    "typecheck": "astro check",
    "test": "npm run build && vitest run && npm run test:smoke",
    "test:smoke": "node scripts/smoke.mjs",
    "audit:anchors": "node scripts/anchor-audit.mjs",
    "assets:orphans": "node scripts/find-orphan-assets.mjs",
    "build:icons": "node scripts/build-brand-icons.mjs",
    "media:index": "node scripts/build-media-index.mjs",
    "media:apply": "node scripts/apply-media.mjs",
    "media:sorter": "node scripts/build-sorter-data.mjs",
    "media:review": "node scripts/build-review-sheets.mjs",
    "media:covers": "node scripts/queue-covers.mjs",
    "media:covers-import": "node scripts/import-covers.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/markdown-satteri": "0.3.4",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/node": "^11.1.1",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.1.3",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "playwright": "1.62.1",
    "sharp": "^0.34.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
